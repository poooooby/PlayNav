return {
  summary   = "Pokemon-Amie and Super Training (X/Y, ORAS rules: play, care after battle, affection benefits, training bags, regimens) on a DS-style bottom touch screen.",
  author    = "Wooble",
  tags      = { "ui", "touch", "mobile", "minigame", "quality-of-life" },
  differences = {
    changed = {
      "After a battle a YES/NO care prompt can appear on both screens; the field and the post-battle script wait for the answer.",
      "AMIE and TRAINING entries are added to the Gen 3 START menu.",
      "Renamed from ds_touch: save data and options kept under the old id are copied once into play_nav on load; the old record stays.",
      "Ten items the Gen 3 games never had (the six stat Wings, Pretty Wing, Dusk, Shiny and Dawn Stone) are registered at ids 400-409; a save that holds them shows them as numbers if the mod is removed.",
      "While an Amie session is open a 256x192 touch surface takes the second display or the lower part of the window, and the engine's built-in virtual pad is hidden.",
    },
    added = {
      "Pokemon-Amie play with the X/Y and ORAS numbers: petting with favored, disfavored and burning / shocking / freezing spots per species (386 species, Bulbapedia-derived), a rapid double-tap hit, the five-second high-five, Poke Puffs in 26 varieties eaten bite by bite while held on the Pokemon, a dance at every 50 affection.",
      "The Amie room: the active Pokemon wanders as its party icon, plays, naps, asks for food; tap it for DECORATE / PLAY / SWITCH.",
      "Berry Picker, Head It and Tile Puzzle with the X/Y ladders: four difficulties, star ratings, Poke Puff rewards, unlocks, three healthy participants.",
      "Decorate: the full decor catalogue (34 wallpapers, 172 items in sets A-F), a drawer to place up to 30 items, a puff set out for visitors.",
      "Visitors from the Pokedex drop by the room, chat and leave presents by their combined affection; milestone, unlock and five-star gifts arrive the same way.",
      "Care after battle: towel, brush, dryer and comb for mud, dust, water and ruffled fur, medicine for status; the tray shows them only while they are needed.",
      "Per-Pokemon affection, fullness and enjoyment in the mod's save data (keyed by personality and OT id): entering a battle and every 50 steps move them, like the games; a Poke Puff jar of up to 100 with one random puff per won battle.",
      "Affection benefits in battle (option, on by default): 1.2x experience at 2 hearts, enduring at 1 HP from 3 hearts, shaking off status at 4, a 10-point accuracy drop for the foe at 200 affection, double critical odds at 5, with the games' messages. Not in link or facility battles.",
      "Super Training: Core Training with the 26 training bags (S/M/L stat bags, Reset, Soothing, the regimen-effect bags), the Effort-o-Meter, automatic hits, rests and second winds, a rack of twelve.",
      "The 18 Super-Training Regimens and 12 Secret regimens with the games' Balloon Bots, scores, EVs, unlock ladder, medals, bags and item prizes, played on the top screen with the touch screen as the aiming pad (move with the d-pad, block with L or BLOCK on screen).",
      "A pointer stream and app registry other mods can build touch minigames on (mod.find('play_nav').exports).",
      "Optional import of the player's own decrypted Alpha Sapphire Rev 2 card image; 421 Pokemon-Amie textures are decoded in-game by pure-Lua readers and cached per install. The mod ships only the recipe, never ROM bytes.",
    },
    known = {
      "Amie runs on Gen 3 only; Gen 1/2 get the surface plumbing without a host adapter.",
      "Petting spots are coarse zones over the front sprite (head, face, cheeks, chest, belly, side, limbs, bottom) mapped from Bulbapedia's text; every Pokemon takes three bites of a puff.",
      "Enduring a hit, dodging and shaking off a status change battle outcomes; turn AFFECTION BENEFITS off for a vanilla battle.",
      "Marks sit on an ellipse over the sprite body rather than on its pixels.",
      "Super Training's points per goal, point loss per hit, guts and charge timings, bag odds and attack schedules are provisional (no public source); data/training_rules.lua marks each number's class and source.",
      "Balloon Bots are the ORAS course badges (regular courses) or the Gen 3 front sprite in a balloon; the secret courses' badges are not mapped yet.",
      "The second display reports one pointer and no pressure; the desktop companion window reports press and release only.",
      "Gen 3 single-screen touch is routed by wrapping the engine's touch controls, because Game3 has no input.pointer seam.",
      "When Kanto Gear also drives the Thor's second display, the two mods take turns: PlayNav has it only while one of its screens is open.",
    },
  },
  credits = { "Petting spots, the Amie stat tables, the Super Training course table and the Energy Shot colours are derived from Bulbapedia (bulbapedia.bulbagarden.net), text under CC BY-NC-SA 2.5.",
              "Item icons for the Wings and the Dusk, Shiny and Dawn Stones are from pokesprite (github.com/msikma/pokesprite, MIT); their names and descriptions from PokeAPI (pokeapi.co)." },
  compat  = { engine = ">=0.0.0-dev <2.0.0", modApi = 2 },
}
